# IDs are exact strings. Comma-separated lists can contain any number of groups.
OWNER_QQ_ID=
BOT_QQ_ID=
QQ_GROUP_ALLOWLIST=
QQ_PRIVATE_ALLOWLIST=
# Filled after the owner's WeChat QR login. This is ilink_user_id, NOT a phone/WeChat nickname.
OWNER_WECHAT_ID=
WECHAT_ALLOW_FROM=
PORT=8080
ONEBOT_ACCESS_TOKEN=GENERATE_RANDOM_64_HEX_CHARACTERS
ENABLE_QQ=1
ENABLE_WECHAT=1
BRAIN_TYPE=dsh
# Model provider and default model are configured globally in DSH Web settings.
DSH_URL=http://127.0.0.1:3080
CODEX_BIN=codex
CODEX_MODEL=
# Optional provider-supported reasoning effort override; empty inherits CLI config.
CODEX_REASONING_EFFORT=
# Custom provider is synced from the user's Codex config.toml; no OpenAI login needed.
# Optional OpenAI API key when using the OpenAI provider. Never commit this file.
API_KEY=
BOT_ALIASES=哈尔莫妮娅,达妮娅,Harmonia
GROUP_REPLY_PROBABILITY=0.05
GROUP_COOLDOWN_MS=90000
GROUP_DIRECT_COOLDOWN_MS=8000
BUBBLE_DELAY_MS=900
# DSH: no-progress timeout; real session events / streaming output renew this timer.
BRAIN_TIMEOUT_MS=180000
# Whole-turn safety deadline (includes thinking, tools and provider retries).
BRAIN_MAX_TURN_MS=900000
# Optional local HTTP proxy for iLink and Codex. Empty means direct connection.
OUTBOUND_PROXY=
# SnowLuma WebUI password is generated at first setup and kept only in local .env.
SNOWLUMA_WEBUI_PASSWORD=
